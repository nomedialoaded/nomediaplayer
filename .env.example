# nomediaplayer — environment overrides (source this, or put it in your
# systemd user environment / shell profile). Empty = not set.
NOMEDIAPLAYER_MPD_HOST=127.0.0.1
NOMEDIAPLAYER_MPD_PORT=6600
NOMEDIAPLAYER_MUSIC_DIR=
NOMEDIAPLAYER_NAVIDROME_URL=
NOMEDIAPLAYER_NAVIDROME_USER=
NOMEDIAPLAYER_NAVIDROME_PASSWORD=
NOMEDIAPLAYER_LIDARR_URL=
NOMEDIAPLAYER_LIDARR_API_KEY=
# NOMEDIAPLAYER_LIDARR_API_KEY_FILE=$HOME/.secrets/lidarr
NOMEDIAPLAYER_FLAC_TO_MP3=false
NOMEDIAPLAYER_HA_URL=
NOMEDIAPLAYER_HA_TOKEN=
NOMEDIAPLAYER_MA_URL=
NOMEDIAPLAYER_MA_TOKEN=
NOMEDIAPLAYER_PODCAST_INDEX_KEY=
NOMEDIAPLAYER_PODCAST_INDEX_SECRET=
